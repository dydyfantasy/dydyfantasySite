<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer HTTPS et retirer le www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.dydyfantasy\.fr$ [NC]
  RewriteRule ^(.*)$ https://dydyfantasy.fr/$1 [L,R=301]

  # Anciennes adresses -> nouvelles (301 : Google transfère les acquis SEO)
  RewriteRule ^notre-approche/?$ https://dydyfantasy.fr/mon-approche [R=301,L]

  # Fichier technique de React Router, à ne pas exposer
  RewriteRule ^__spa-fallback\.html$ - [R=404,L]

  # Une seule version de chaque adresse : /contact/ -> /contact
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ https://dydyfantasy.fr/$1 [R=301,L]

  # Pages pré-rendues : /contact sert contact/index.html (l'adresse reste /contact)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

# Pas de redirection automatique /contact -> /contact/ (sinon conflit avec le canonical)
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Pas de liste des fichiers d'un dossier
Options -Indexes

# Toute adresse inconnue : vraie page 404 (code HTTP 404)
ErrorDocument 404 /404/index.html

# Pages et textes en UTF-8 (accents) annoncés dans l'en-tête HTTP
AddDefaultCharset UTF-8

# En-têtes de sécurité
<IfModule mod_headers.c>
  # HTTPS obligatoire pendant 1 an
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # Le navigateur ne devine pas le type d'un fichier (ex. un texte exécuté comme script)
  Header always set X-Content-Type-Options "nosniff"
  # Le site ne peut pas être affiché dans un cadre sur un autre site (anti-clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Les autres sites voient seulement « dydyfantasy.fr » comme provenance, pas l'adresse exacte
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Caméra, micro et position : jamais demandés par le site
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Les pages peuvent être revalidées (réponse 304 « pas changé ») au lieu d'être renvoyées en entier
FileETag MTime Size

# --- Compression Gzip ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# --- Cache pour fichiers statiques ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

# Fichiers de /assets/ : leur nom change à chaque compilation (ex. root-DxGYNvJ9.css),
# on peut donc les garder en cache 1 an sans risque
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
# Agenda : jamais en cache (on coupe aussi la règle générale des .js de mod_expires)
<IfModule mod_expires.c>
  <Files "events.js">
    ExpiresActive Off
  </Files>
</IfModule>
<IfModule mod_headers.c>
  <Files "events.js">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </Files>
</IfModule>